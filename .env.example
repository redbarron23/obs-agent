# Copy to .env and fill in what you use. docker compose loads this file.

# Default provider and model for the CLI, API and web UI.
# Unset: ollama / qwen2.5:7b (local, free, but small models can guess).
# OBS_AGENT_PROVIDER=anthropic   # anthropic | openai | deepseek | ollama
# OBS_AGENT_MODEL=               # optional; applies to OBS_AGENT_PROVIDER only

# Ollama is the default provider and needs no key; these are for other providers.
DEEPSEEK_API_KEY=
# Used with --provider anthropic
ANTHROPIC_API_KEY=
# Used with --provider openai
OPENAI_API_KEY=
# Used with --provider ollama (no API key needed)
OLLAMA_HOST=http://localhost:11434
